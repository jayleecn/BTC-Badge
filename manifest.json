{
    "manifest_version": 3,
    "name": "BTC Badge - Bitcoin Price Ticker",
    "version": "0.2.0",
    "description": "Track BTC price on the Chrome badge (MVRV/Pi shown when a free source is available)",
    "permissions": [
        "alarms",
        "storage"
    ],
    "host_permissions": [
        "https://api.coinbase.com/",
        "https://mempool.space/",
        "https://api.kraken.com/",
        "https://api.coinpaprika.com/"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "icons": {
        "16": "icon16.png",
        "128": "icon128.png"
    }
}
